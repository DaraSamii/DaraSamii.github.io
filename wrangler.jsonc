// Cloudflare Workers static-assets config for darasamii.com.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` uploads dist/ (no server code, no secrets).
{
  "name": "darasamii-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
