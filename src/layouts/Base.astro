---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { content, useT, alternates } from '../i18n/index.js';

const { lang = 'en', title, description, image = '/assets/images/profile/1.jpg', fullBleed = false, translated = true } = Astro.props;
const t = useT(lang);
const { profile, socials } = content(lang);
const desc = description ?? profile.intro;
const alt = alternates(Astro.url.pathname);
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.jobTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.shortName,
  url: profile.site,
  image: new URL('/assets/images/profile/1.jpg', Astro.site).href,
  jobTitle: profile.jobTitle,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'McGill University' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Concordia University' },
    { '@type': 'CollegeOrUniversity', name: 'University of Tehran' },
    { '@type': 'CollegeOrUniversity', name: 'Iran University of Science and Technology' },
  ],
  knowsAbout: ['Computational Fluid Dynamics', 'OpenFOAM', 'Rocketry', 'Combustion', 'Graph Neural Networks', 'Aeroacoustics'],
  sameAs: socials.map((s) => s.href),
};
// Home pages are marked as a profile page about this person (Google's ProfilePage rich result).
const isHome = alt.en === '/' && translated && (Astro.url.pathname === '/' || Astro.url.pathname === '/fr/');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${Astro.site}#site`, name: profile.name, url: Astro.site.href, inLanguage: ['en-CA', 'fr-CA'] },
    { ...personLd, '@context': undefined, '@id': `${Astro.site}#person` },
    ...(isHome ? [{ '@type': 'ProfilePage', url: canonical.href, inLanguage: t('meta.htmlLang'), mainEntity: { '@id': `${Astro.site}#person` } }] : []),
  ],
};
---
<!doctype html>
<html lang={t('meta.htmlLang')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {translated && <>
      <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
      <link rel="alternate" hreflang="fr" href={new URL(alt.fr, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(alt.en, Astro.site)} />
    </>}
    <meta property="og:locale" content={t('meta.ogLocale')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1317" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <!-- Page background before the stylesheet arrives, so a page that hasn't drawn yet is never browser-white. -->
    <style is:inline>
      html { background: #ffffff; color-scheme: light; }
      html[data-theme='dark'] { background: #0a1317; color-scheme: dark; }
      @media (prefers-color-scheme: dark) { html:not([data-theme='light']) { background: #0a1317; color-scheme: dark; } }
    </style>
    <script is:inline>
      // Old address → new domain, keeping the path. Runs before paint.
      if (location.hostname.endsWith('github.io')) location.replace('https://darasamii.com' + location.pathname + location.search + location.hash);
      (function () {
        var root = document.documentElement;
        function applyTheme() {
          var t = null;
          try { t = localStorage.getItem('theme'); } catch (e) {}
          if (t === 'light' || t === 'dark') root.dataset.theme = t; else delete root.dataset.theme;
        }
        applyTheme();
        root.classList.add('js');
        // A page prepared in the background (speculation rules) re-reads the theme when it is shown.
        document.addEventListener('prerenderingchange', applyTheme);
      })();
    </script>
    <!-- Hovering a link prepares that page in the background, so the click is instant (no half-drawn page in between). -->
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": ["/*.pdf", "/CV/*", "/_img/*", "/assets/*"] } }] }, "eagerness": "moderate" }] }
    </script>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-jetbrains" preload />
    <!-- Icons load without blocking the first paint. -->
    <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Nav lang={lang} translated={translated} />
    <main id="main">
      <slot />
    </main>
    {!fullBleed && <Footer lang={lang} />}
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
