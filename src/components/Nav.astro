---
import { content, useT, lp, alternates } from '../i18n/index.js';
const { lang = 'en' } = Astro.props;
const t = useT(lang);
const { profile, cvHref } = content(lang);
const items = ['home', 'research', 'rocketry', 'teaching', 'projects', 'blog', 'piano', 'world'].map((k) => ({
  label: t(`nav.${k}`),
  href: lp(k === 'home' ? '/' : `/${k}/`, lang),
}));
const path = Astro.url.pathname.replace(/\/?$/, '/');
const home = lp('/', lang);
const isActive = (href) => (href === home ? path === home : path.startsWith(href));
const other = lang === 'fr' ? 'en' : 'fr';
const alt = alternates(Astro.url.pathname);
---
<header class="navbar">
  <div class="container nav-inner">
    <a href={home} class="nav-logo" aria-label={`${profile.name}, ${t('nav.home')}`}>
      <img class="mark" src="/logo.svg" width="36" height="36" alt="" />
      <span>Dara Samii</span>
    </a>
    <ul class="nav-menu" id="nav-menu">
      {items.map((item) => {
        const active = isActive(item.href);
        return (
          <li>
            {/* The black bubble: a separate element so page transitions can slide it from one link to the next. */}
            {active && <span class="nav-pill" aria-hidden="true"></span>}
            <a href={item.href} class="nav-link" aria-current={active ? 'page' : undefined}>{item.label}</a>
          </li>
        );
      })}
    </ul>
    <div class="nav-actions">
      {/* Language: a two-option switch; the knob sits on the current language and slides before navigating. */}
      <a href={alt[other]} class="seg seg-lang" data-pos={lang === 'fr' ? 1 : 0} data-lang-switch hreflang={other} aria-label={t('nav.switchLabel')} title={t('nav.switchLabel')}>
        <span class="seg-knob" aria-hidden="true"></span>
        <span class="seg-opt" lang="en">EN</span>
        <span class="seg-opt" lang="fr">FR</span>
      </a>
      {/* Theme: knob position comes from CSS (data-theme / OS preference), so it is right before any JS runs. */}
      <button class="seg seg-theme theme-toggle" type="button" role="switch" aria-label={t('nav.theme')}>
        <span class="seg-knob" aria-hidden="true"></span>
        <span class="seg-opt" aria-hidden="true"><i class="fas fa-sun"></i></span>
        <span class="seg-opt" aria-hidden="true"><i class="fas fa-moon"></i></span>
      </button>
      <a href={cvHref} class="btn btn-primary btn-sm" target="_blank" rel="noopener"><i class="fas fa-file-pdf" aria-hidden="true"></i><span class="nav-cv-label">{t('nav.cv')}</span><span class="sr-only"> (PDF)</span></a>
      <button class="icon-btn nav-toggle" type="button" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="nav-menu">
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>
