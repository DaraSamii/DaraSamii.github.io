---
import { content, useT, lp, alternates } from '../i18n/index.js';
const { lang = 'en' } = Astro.props;
const t = useT(lang);
const { profile, cvHref, coffee } = content(lang);
const items = ['home', 'research', 'rocketry', 'teaching', 'projects', 'blog', 'piano', 'world'].map((k) => ({
  label: t(`nav.${k}`),
  href: lp(k === 'home' ? '/' : `/${k}/`, lang),
}));
const path = Astro.url.pathname.replace(/\/?$/, '/');
const home = lp('/', lang);
const isActive = (href) => (href === home ? path === home : path.startsWith(href));
const other = lang === 'fr' ? 'en' : 'fr';
const switchHref = alternates(Astro.url.pathname)[other];
---
<header class="navbar">
  <div class="container nav-inner">
    <a href={home} class="nav-logo" aria-label={`${profile.name}, ${t('nav.home')}`}>
      <img class="mark" src="/assets/images/avatar.jpg" width="36" height="36" alt="" decoding="async" />
      <span>Dara Samii</span>
    </a>
    <ul class="nav-menu" id="nav-menu">
      {items.map((item) => (
        <li><a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <a href={switchHref} class="lang-switch" hreflang={t('nav.switchLang')} lang={t('nav.switchLang')} aria-label={t('nav.switchLabel')} title={t('nav.switchLabel')} data-lang-switch={other}>{t('nav.switch')}</a>
      <a href={cvHref} class="btn btn-primary btn-sm" target="_blank" rel="noopener"><i class="fas fa-file-pdf" aria-hidden="true"></i><span class="nav-cv-label">{t('nav.cv')}</span><span class="sr-only"> (PDF)</span></a>
      <a class="icon-btn coffee" href={coffee.href} target="_blank" rel="noopener" aria-label={coffee.label} title={coffee.label}><i class="fas fa-mug-hot" aria-hidden="true"></i></a>
      <button class="icon-btn theme-toggle" type="button" aria-label={t('nav.theme')}>
        <i class="fas fa-moon" aria-hidden="true"></i><i class="fas fa-sun" aria-hidden="true"></i>
      </button>
      <button class="icon-btn nav-toggle" type="button" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="nav-menu">
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>
