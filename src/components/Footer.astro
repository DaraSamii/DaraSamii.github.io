---
import { content, useT, lp } from '../i18n/index.js';
const { lang = 'en' } = Astro.props;
const t = useT(lang);
const { profile, socials, cvHref, coffee } = content(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2>{profile.name}</h2>
        <p>{profile.role}<br />{profile.location}</p>
        <p style="margin-top:12px"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      </div>
      <div>
        <h2>{t('footer.work')}</h2>
        <ul>
          <li><a href={lp('/research/', lang)}>{t('nav.research')}</a></li>
          <li><a href={lp('/rocketry/', lang)}>{t('nav.rocketry')}</a></li>
          <li><a href={lp('/teaching/', lang)}>{t('footer.teaching')}</a></li>
          <li><a href={lp('/projects/', lang)}>{t('footer.projects')}</a></li>
          <li><a href={cvHref} target="_blank" rel="noopener">{t('footer.cv')}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t('footer.personal')}</h2>
        <ul>
          <li><a href={lp('/blog/', lang)}>{t('nav.blog')}</a></li>
          <li><a href={lp('/piano/', lang)}>{t('nav.piano')}</a></li>
          <li><a href={lp('/world/', lang)}>{t('nav.world')}</a></li>
          <li><a href={lp('/#airfoil', lang)}>{t('footer.airfoil')}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t('footer.elsewhere')}</h2>
        <ul>
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener"><i class={s.icon} aria-hidden="true" style={`color:${s.color}`}></i> {s.label}</a></li>)}
          <li><a href={coffee.href} target="_blank" rel="noopener"><i class="fas fa-mug-hot" aria-hidden="true" style="color:#f2a918"></i> {coffee.label}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} {profile.name}. {t('footer.built')}</span>
    </div>
  </div>
</footer>
