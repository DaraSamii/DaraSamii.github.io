---
import { useT } from '../i18n/index.js';
import { opt } from '../lib/img.js';
const { p, lang = 'en' } = Astro.props;
const t = useT(lang);
const imgs = p.images ?? [];
---
<article class="card card-hover project reveal" data-cats={p.category.join(' ')} id={p.slug}>
  <div class:list={['project-media', { white: p.whiteBg }]} data-slides={imgs.length ? '' : undefined}>
    {imgs.length ? (
      <>
        {/* Only the first slide loads; site.js fills in the others just before they are shown. */}
        {imgs.map((im, i) => <img src={i === 0 ? opt(im.src, 960) : undefined} data-src={i === 0 ? undefined : opt(im.src, 960)} data-full={opt(im.src, 1600)} alt={im.alt} loading="lazy" decoding="async" class={i === 0 ? 'active' : undefined} />)}
        {imgs.length > 1 && (
          <>
            <button class="slide-nav slide-prev" type="button" aria-label={t('common.prev')}>‹</button>
            <button class="slide-nav slide-next" type="button" aria-label={t('common.next')}>›</button>
            <div class="slide-dots" aria-hidden="true">{imgs.map((_, i) => <span class={i === 0 ? 'on' : undefined} />)}</div>
          </>
        )}
      </>
    ) : (
      <div class="placeholder"><i class={p.icon ?? 'fas fa-flask'} aria-hidden="true"></i></div>
    )}
  </div>
  <div class="project-body">
    {p.featured && <span class="kicker">{t('common.featured')}</span>}
    <h3>{p.title}</h3>
    <p set:html={p.summary} />
    <div class="tags">{p.tech.map((t) => <span class="tag">{t}</span>)}</div>
    {p.details && (
      <details class="more">
        <summary>{t('common.details')}</summary>
        <p set:html={p.details} />
      </details>
    )}
    <div class="links">
      {p.links.map((l) => <a class="link-chip" href={l.href} target="_blank" rel="noopener"><i class={l.icon} aria-hidden="true"></i> {l.label}</a>)}
    </div>
  </div>
</article>
