---
// Large project block for Research/Rocketry: big gallery with thumbnails, full write-up, links.
import { useT } from '../i18n/index.js';
import { opt } from '../lib/img.js';
const { p, flip = false, lang = 'en' } = Astro.props;
const t = useT(lang);
const imgs = p.images ?? [];
---
<article class:list={['feature reveal', { flip }]} id={p.slug}>
  <div class="feature-gallery" data-gallery>
    {imgs.length ? (
      <>
        <div class="feature-stage">
          <button class="feature-main" type="button" aria-label={`${t('common.openFull')} — ${p.title}`}>
            <img src={opt(imgs[0].src, 960)} srcset={`${opt(imgs[0].src, 960)} 960w, ${opt(imgs[0].src, 1600)} 1600w`} sizes="(max-width: 900px) 100vw, 640px" data-full={opt(imgs[0].src, 1600)} alt={imgs[0].alt} loading="lazy" decoding="async" />
          </button>
          {imgs.length > 1 && (
            <>
              <button class="gal-nav gal-prev" type="button" aria-label={t('common.prev')}><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
              <button class="gal-nav gal-next" type="button" aria-label={t('common.next')}><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
            </>
          )}
          <span class="feature-count" aria-live="polite"><i class="fas fa-images" aria-hidden="true"></i> <span data-idx>1</span> / {imgs.length}</span>
        </div>
        {imgs.length > 1 && (
          <div class="feature-thumbs" role="group" aria-label={t('common.images')}>
            {imgs.map((im, i) => (
              <button type="button" class="thumb" aria-pressed={i === 0 ? 'true' : 'false'} data-src={opt(im.src, 960)} data-full={opt(im.src, 1600)} data-alt={im.alt} aria-label={im.alt}>
                <img src={opt(im.src, 400)} alt="" loading="lazy" decoding="async" width="84" height="58" />
              </button>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="feature-main placeholder"><i class={p.icon ?? 'fas fa-flask'} aria-hidden="true"></i></div>
    )}
  </div>
  <div class="feature-body">
    {p.featured && <span class="kicker">{t('common.featured')}</span>}
    <h3>{p.title}</h3>
    <p set:html={p.summary} />
    {p.details && <p set:html={p.details} />}
    <div class="tags">{p.tech.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="links">
      {p.links.map((l) => <a class="link-chip" href={l.href} target="_blank" rel="noopener"><i class={l.icon} aria-hidden="true"></i> {l.label}</a>)}
    </div>
  </div>
</article>
