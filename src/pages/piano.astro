---
import Base from '../layouts/Base.astro';
import { pianoVideos } from '../data/personal.js';
---
<Base title="Piano" description="Piano Corner: blues, jazz and boogie-woogie improvisation by Dara Rahmat Samii.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Piano Corner</span>
      <h1>🎹 Blues, jazz and boogie-woogie</h1>
      <p class="lead">Music has always been a passion of mine alongside my academic pursuits. Especially interested in Blues, Jazz, and Boogie-Woogie styles, I enjoy improvising and creating unique renditions of classic pieces.</p>
      <div class="actions"><a class="btn btn-cobalt" href="https://www.youtube.com/@dara_samii" target="_blank" rel="noopener"><i class="fab fa-youtube" aria-hidden="true"></i> Subscribe on YouTube</a></div>
    </div>
  </section>
  <section class="section" style="padding-top:8px">
    <div class="container grid grid-2">
      {pianoVideos.map((v) => (
        <div class="video reveal">
          <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}`} title={v.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      ))}
    </div>
  </section>
</Base>
