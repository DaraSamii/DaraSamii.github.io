---
import Base from '../../../layouts/Base.astro';
import ImageModal from '../../../components/ImageModal.astro';
import { getCollection } from 'astro:content';
import { langPaths, getLang, content, useT } from '../../../i18n/index.js';
import { opt } from '../../../lib/img.js';
export function getStaticPaths() { return langPaths(); }
const lang = getLang(Astro);
const t = useT(lang);
const { teachingRoles, courses, materials } = content(lang);
const notes = (await getCollection('notes', (n) => !n.data.draft)).sort((a, b) => b.data.date - a.data.date);
const fmt = (d) => d.toLocaleDateString(lang === 'fr' ? 'fr-CA' : 'en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base lang={lang} title={t('nav.teaching')} description={t('desc.teaching')}>
  <section class="page-hero">
    <div class="container">
      <span class="kicker">{t('teaching.kicker')}</span>
      <h1>{t('teaching.title')}</h1>
      <p class="lead" set:html={t('teaching.lead')} />
      <div class="actions">
        <a class="btn btn-primary" href="#award"><i class="fas fa-award" aria-hidden="true" style="color:#f2a918"></i> {t('teaching.awardBtn')}</a>
        <a class="btn btn-secondary" href="#materials">{t('teaching.materialsBtn')}</a>
        <a class="btn btn-secondary" href="#courses">{t('teaching.coursesBtn')}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="award">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{t('teaching.awardKicker')}</span><h2>{t('teaching.awardTitle')}</h2>
        <p set:html={t('teaching.awardText')} /></div></div>
      <div class="award-mosaic" data-photos>
        <figure class="award-main">
          <button type="button" aria-label={`${t('common.openPhoto')} — ${t('teaching.capCert')}`}><img src={opt('/assets/images/teaching/award-certificate.jpg', 960)} data-full={opt('/assets/images/teaching/award-certificate.jpg', 1600)} decoding="async" alt={t('teaching.altCert')} loading="lazy" /></button>
          <figcaption>{t('teaching.capCert')}</figcaption>
        </figure>
        <figure>
          <button type="button" aria-label={`${t('common.openPhoto')} — ${t('teaching.capStage')}`}><img src={opt('/assets/images/teaching/award-ceremony.jpg', 960)} data-full={opt('/assets/images/teaching/award-ceremony.jpg', 1600)} decoding="async" alt={t('teaching.altStage')} loading="lazy" /></button>
          <figcaption>{t('teaching.capStage')}</figcaption>
        </figure>
        <figure>
          <button type="button" aria-label={`${t('common.openPhoto')} — ${t('teaching.capGroup')}`}><img src={opt('/assets/images/teaching/award-recipients.jpg', 960)} data-full={opt('/assets/images/teaching/award-recipients.jpg', 1600)} decoding="async" alt={t('teaching.altGroup')} loading="lazy" /></button>
          <figcaption>{t('teaching.capGroup')}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="materials">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{t('teaching.matKicker')}</span><h2>{t('teaching.matTitle')}</h2><p>{t('teaching.matLead')}</p></div></div>
      <div class="features">
        {materials.map((m, i) => (
          <article class:list={['feature material reveal', { flip: i % 2 === 1 }]}>
            <a class="material-cover" href={m.href} target="_blank" rel="noopener" aria-label={`${t('teaching.read')} — ${m.title}`}>
              <img src={opt(m.cover, 960)} alt={`${t('teaching.coverOf')} ${m.title}`} loading="lazy" decoding="async" />
            </a>
            <div class="feature-body">
              <span class="kicker">{m.kind}</span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
              <ol class="chapters">{m.chapters.map((c) => <li>{c}</li>)}</ol>
              <div class="links">
                <a class="btn btn-primary btn-sm" href={m.href} target="_blank" rel="noopener"><i class="fas fa-book-open" aria-hidden="true"></i> {t('teaching.read')}</a>
                <a class="btn btn-secondary btn-sm" href={m.href} download><i class="fas fa-download" aria-hidden="true"></i> {t('teaching.download')}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {notes.length > 0 && (
    <section class="section section-alt" id="notes">
      <div class="container">
        <div class="section-head"><div><span class="kicker">{t('teaching.notes')}</span><h2>{t('teaching.notesTitle')}</h2></div></div>
        <div class="grid grid-3">
          {notes.map((n) => (
            <a class="card card-hover reveal" href={`/teaching/${n.id}/`} style="color:inherit;text-decoration:none;display:grid;gap:10px">
              <span class="kicker">{n.data.course}</span>
              <h3>{n.data.title}</h3>
              <p class="meta">{n.data.description}</p>
              <span class="meta">{fmt(n.data.date)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class:list={['section', { 'section-alt': notes.length === 0 }]} id="courses">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{t('teaching.courses')}</span><h2>{t('teaching.coursesTitle')}</h2>{notes.length === 0 && <p>{t('teaching.notesSoon')}</p>}</div></div>
      <div class="grid grid-4">
        {courses.map((c) => (
          <div class="card reveal row" style="padding:18px 20px;align-items:center">
            <div class="card-icon"><i class={c.icon} aria-hidden="true"></i></div>
            <div><h3 style="font-size:16px">{c.name}</h3><p class="meta">{c.kind}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{t('teaching.exp')}</span><h2>{t('teaching.expTitle')}</h2></div></div>
      <div class="grid">
        {teachingRoles.map((r) => (
          <div class="card reveal">
            <div class="row" style="justify-content:space-between;flex-wrap:wrap">
              <div><h3>{r.role}</h3><p class="meta">{r.org}</p></div>
              <span class="tag">{r.date}</span>
            </div>
            {r.highlight && <p style="margin-top:12px"><span class="tag tag-cobalt"><i class="fas fa-award" aria-hidden="true"></i> {r.highlight}</span></p>}
            <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <ImageModal lang={lang} />
</Base>
