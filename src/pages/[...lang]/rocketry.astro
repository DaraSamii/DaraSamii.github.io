---
import Base from '../../layouts/Base.astro';
import ProjectFeature from '../../components/ProjectFeature.astro';
import ImageModal from '../../components/ImageModal.astro';
import { langPaths, getLang, content, useT } from '../../i18n/index.js';
import { opt } from '../../lib/img.js';
export function getStaticPaths() { return langPaths(); }
const lang = getLang(Astro);
const t = useT(lang);
const { projects, certifications, conferences } = content(lang);
const rocketry = projects.filter((p) => p.rocketry);
const levels = certifications.filter((c) => c.level).reverse(); // L1 → L3
const talk = conferences.find((c) => c.title.includes('Supersonic Rocket'));
const fr = lang === 'fr';
---
<Base lang={lang} title={t('nav.rocketry')} description={t('desc.rocketry')} image="/assets/images/projects/cr26-cfd/launch.jpg">
  <section class="page-hero">
    <div class="container feature-split">
      <div>
        <span class="kicker">{t('rocketry.kicker')}</span>
        <h1>{t('rocketry.title')}</h1>
        <p class="lead">{t('rocketry.lead')}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#cr26">{t('rocketry.cr26btn')}</a>
          <a class="btn btn-secondary" href="#projects">{t('rocketry.projectsBtn')}</a>
          <a class="btn btn-secondary" href="#certifications">{t('rocketry.rocketsBtn')}</a>
        </div>
      </div>
      <img src={opt('/assets/images/rocketry/me-and-rocket.jpg', 960)} alt={t('rocketry.heroAlt')} style="max-height:520px" fetchpriority="high" />
    </div>
  </section>

  <section class="section section-alt" id="cr26">
    <div class="container feature-split">
      <div>
        <span class="kicker">{t('rocketry.cr26kicker')}</span>
        <h2 style="font-size:clamp(28px,3.6vw,40px);margin-top:8px">{t('rocketry.cr26title')}</h2>
        <p style="margin-top:14px;color:var(--charcoal);font-size:17px">{t('rocketry.cr26lead')}</p>
        <div class="card" style="margin-top:24px;padding:8px 8px">
          <table class="flight-table">
            <thead><tr><th></th><th>{t('rocketry.booster')}</th><th>{t('rocketry.sustainer')}</th></tr></thead>
            <tbody>
              <tr><td>{t('rocketry.apogee')}</td><td>{fr ? '14 364 pi (4 378 m)' : '14,364 ft (4,378 m)'}</td><td><b>{fr ? '47 991 pi (14 628 m)' : '47,991 ft (14,628 m)'}</b></td></tr>
              <tr><td>{t('rocketry.maxSpeed')}</td><td>{fr ? '1 002 pi/s*' : '1,002 ft/s*'}</td><td>{fr ? '1 599 pi/s (487 m/s)' : '1,599 ft/s (487 m/s)'}</td></tr>
              <tr><td>{t('rocketry.peakMach')}</td><td>{fr ? '0,92*' : '0.92*'}</td><td><b>{fr ? '1,54' : '1.54'}</b></td></tr>
            </tbody>
          </table>
          <p class="meta" style="padding:8px 14px">{t('rocketry.gap')}</p>
        </div>
      </div>
      <img src={opt('/assets/images/projects/cr26-cfd/launch.jpg', 960)} alt={t('rocketry.launchAlt')} loading="lazy" decoding="async" style="max-height:560px" />
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <div><span class="kicker">{t('rocketry.projKicker')}</span><h2>{t('rocketry.projTitle')}</h2>
        <p>{t('rocketry.projLead')}</p></div>
      </div>
      <div class="features">{rocketry.map((p, i) => <ProjectFeature p={p} flip={i % 2 === 1} lang={lang} />)}</div>
    </div>
  </section>

  <section class="section section-alt" id="certifications">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{levels[0]?.org}</span><h2>{t('rocketry.certTitle')}</h2>
        <p>{t('rocketry.certLead')}</p></div></div>
      <div class="grid grid-3">
        {levels.map((c) => (
          <div class="card cert-card reveal">
            <div class="row" style="justify-content:space-between;align-items:baseline">
              <span class="level">{c.level}</span><span class="tag">{c.date}</span>
            </div>
            <div><p class="meta">{t('common.rocket')}</p><p class="rocket">{c.rocket}</p></div>
            <div class="photos" data-photos>
              {c.images.map((im) => <button type="button" aria-label={`${t('common.openPhoto')} — ${im.alt}`}><img src={opt(im.src, 400)} data-full={opt(im.src, 1600)} alt={im.alt} loading="lazy" decoding="async" /></button>)}
            </div>
            <p class="meta">{c.title} · {c.org}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {talk && (
    <section class="section" style="padding-bottom:var(--s-section)">
      <div class="container">
        <div class="promo" style="grid-template-columns:1fr">
          <div><span class="kicker" style="color:var(--primary)">{t('rocketry.talk')} · {talk.date}</span><h2 style="margin-top:8px" lang="en">{talk.title}</h2><p>{talk.venue}</p></div>
        </div>
      </div>
    </section>
  )}
  <ImageModal lang={lang} />
</Base>
