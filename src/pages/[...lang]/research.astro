---
import Base from '../../layouts/Base.astro';
import PubList from '../../components/PubList.astro';
import ProjectFeature from '../../components/ProjectFeature.astro';
import ImageModal from '../../components/ImageModal.astro';
import { langPaths, getLang, content, useT, lp } from '../../i18n/index.js';
export function getStaticPaths() { return langPaths(); }
const lang = getLang(Astro);
const t = useT(lang);
const { themes, conferences, researchInterests, bySlug, socials } = content(lang);
const scholar = socials.find((s) => s.label === 'Google Scholar').href;
---
<Base lang={lang} title={t('nav.research')} description={t('desc.research')}>
  <section class="page-hero">
    <div class="container">
      <span class="kicker">{t('research.kicker')}</span>
      <h1>{t('research.title')}</h1>
      <p class="lead">{t('research.lead')}</p>
      <div class="actions">
        <a class="btn btn-primary" href={scholar} target="_blank" rel="noopener"><i class="fas fa-graduation-cap" aria-hidden="true"></i> {t('research.scholar')}</a>
        <a class="btn btn-secondary" href="#publications">{t('research.pubsBtn')}</a>
      </div>
      <div class="tags" style="margin-top:28px">{researchInterests.map((r) => <span class="tag tag-cobalt">{r}</span>)}</div>
    </div>
  </section>

  {themes.map((th, n) => (
    <section class:list={['section', { 'section-alt': n % 2 === 0 }]} id={th.id} style="padding:80px 0">
      <div class="container">
        <div class="row" style="gap:20px">
          <div class="card-icon" style={`width:56px;height:56px;font-size:22px;--ic:${th.color}`}><i class={th.icon} aria-hidden="true"></i></div>
          <div style="max-width:820px">
            <span class="kicker">{th.kicker}</span>
            <h2 style="font-size:clamp(26px,3.2vw,36px);margin-top:8px">{th.title}</h2>
            <p style="margin-top:14px;font-size:17px;color:var(--charcoal);line-height:1.65">{th.text}</p>
            <div class="tags" style="margin-top:14px">{th.tags.map((x) => <span class="tag">{x}</span>)}</div>
            {(th.links || th.more) && (
              <div class="links">
                {th.links?.map((l) => <a class="link-chip" href={l.href} target="_blank" rel="noopener"><i class={l.icon} aria-hidden="true"></i> {l.label}</a>)}
                {th.more && <a class="link-chip" href={lp(th.more.href, lang)}>{th.more.label} →</a>}
              </div>
            )}
          </div>
        </div>
        {th.projects && <div class="features" style="margin-top:48px">{th.projects.map((s, i) => <ProjectFeature p={bySlug[s]} flip={i % 2 === 1} lang={lang} />)}</div>}
      </div>
    </section>
  ))}

  <section class="section" id="publications">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{t('home.pubs')}</span><h2>{t('research.papers')}</h2></div></div>
      <PubList lang={lang} />
    </div>
  </section>

  <section class="section section-alt" id="talks">
    <div class="container">
      <div class="section-head"><div><span class="kicker">{t('research.confs')}</span><h2>{t('research.talks')}</h2></div></div>
      <div class="grid">
        {conferences.map((c) => (
          <article class="card pub reveal">
            <div class="pub-year" style="font-size:16px">{c.date}</div>
            <div>
              <h3 lang="en">{c.title}</h3>
              <p class="venue">{c.venue}</p>
              {c.href && <div class="links"><a class="link-chip" href={c.href} target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> {t('common.abstract')}</a></div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ImageModal lang={lang} />
</Base>
