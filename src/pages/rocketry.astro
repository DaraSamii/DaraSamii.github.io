---
import Base from '../layouts/Base.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ImageModal from '../components/ImageModal.astro';
import { projects } from '../data/projects.js';
import { certifications } from '../data/cv.js';
import { conferences } from '../data/research.js';
const rocketry = projects.filter((p) => p.rocketry);
const levels = certifications.filter((c) => c.level).reverse(); // L1 → L3
const talk = conferences.find((c) => c.title.includes('Supersonic Rocket'));
---
<Base title="Rocketry" description="High-power rocketry by Dara Rahmat Samii: CFD lead for Space Concordia CR25 and CR26 (Mach 1.54, 47,991 ft), OpenRocket and RocketCalculator contributions, L3 certified with the Canadian Association of Rocketry." image="/assets/images/projects/cr26-cfd/launch.jpg">
  <section class="page-hero">
    <div class="container feature-split">
      <div>
        <span class="kicker">Rocketry</span>
        <h1>CFD for rockets that actually fly</h1>
        <p class="lead">CFD Team Lead for Space Concordia’s solid rocketry team since Dec 2024, L3-certified flyer with the Canadian Association of Rocketry, and contributor to the open-source tools rocketeers use every day: OpenRocket and RocketCalculator.</p>
        <div class="actions">
          <a class="btn btn-primary" href="#cr26">CR26 flight</a>
          <a class="btn btn-secondary" href="#projects">Projects</a>
          <a class="btn btn-secondary" href="#certifications">My rockets</a>
        </div>
      </div>
      <img src="/assets/images/rocketry/me-and-rocket.jpg" alt="Dara beside Space Concordia’s CR25 rocket, Aether, on the launch rail at Launch Canada" style="max-height:520px" />
    </div>
  </section>

  <section class="section section-alt" id="cr26">
    <div class="container feature-split">
      <div>
        <span class="kicker">Launch Canada · 19 Aug 2026</span>
        <h2 style="font-size:clamp(28px,3.6vw,40px);margin-top:8px">CR26: two stages, supersonic</h2>
        <p style="margin-top:14px;color:var(--charcoal);font-size:17px">Booster + sustainer, designed with CFD coefficients, centre of pressure and distributed loads from my OpenFOAM/cfMesh study, then compared with GPS/LoRa telemetry from both stages.</p>
        <div class="card" style="margin-top:24px;padding:8px 8px">
          <table class="flight-table">
            <thead><tr><th></th><th>Booster</th><th>Sustainer</th></tr></thead>
            <tbody>
              <tr><td>Apogee (AGL)</td><td>14,364 ft (4,378 m)</td><td><b>47,991 ft (14,628 m)</b></td></tr>
              <tr><td>Max observed speed</td><td>1,002 ft/s*</td><td>1,599 ft/s (487 m/s)</td></tr>
              <tr><td>Peak Mach observed</td><td>0.92*</td><td><b>1.54</b></td></tr>
            </tbody>
          </table>
          <p class="meta" style="padding:8px 14px">* after a telemetry gap; the true booster peak is higher.</p>
        </div>
      </div>
      <img src="/assets/images/projects/cr26-cfd/launch.jpg" alt="CR26 lifting off at Launch Canada, 19 August 2026" loading="lazy" style="max-height:560px" />
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <div><span class="kicker">Projects &amp; open source</span><h2>Simulation, tools and contributions</h2>
        <p>Space Concordia CFD, new OpenRocket features, and the RocketCalculator site and paper.</p></div>
      </div>
      <div class="features">{rocketry.map((p, i) => <ProjectFeature p={p} flip={i % 2 === 1} />)}</div>
    </div>
  </section>

  <section class="section section-alt" id="certifications">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Canadian Association of Rocketry</span><h2>My rockets: the certification ladder</h2>
        <p>Each level is a solo build and flight on a bigger motor class.</p></div></div>
      <div class="grid grid-3">
        {levels.map((c) => (
          <div class="card cert-card reveal">
            <div class="row" style="justify-content:space-between;align-items:baseline">
              <span class="level">{c.level}</span><span class="tag">{c.date}</span>
            </div>
            <div><p class="meta">Rocket</p><p class="rocket">{c.rocket}</p></div>
            <div class="photos" data-photos>
              {c.images.map((im) => <button type="button" aria-label={`Open photo: ${im.alt}`}><img src={im.src} alt={im.alt} loading="lazy" /></button>)}
            </div>
            <p class="meta">{c.title} · {c.org}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {talk && (
    <section class="section" style="padding-bottom:var(--s-section)">
      <div class="container">
        <div class="promo" style="grid-template-columns:1fr">
          <div><span class="kicker" style="color:var(--primary)">Talk · {talk.date}</span><h2 style="margin-top:8px">{talk.title}</h2><p>{talk.venue}</p></div>
        </div>
      </div>
    </section>
  )}
  <ImageModal />
</Base>
