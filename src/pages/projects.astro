---
import Base from '../layouts/Base.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ImageModal from '../components/ImageModal.astro';
import { projects, categories } from '../data/projects.js';
import { themes } from '../data/research.js';
// Projects featured on /research or /rocketry live there, not here. Each remaining project sits under its first category.
const elsewhere = new Set([...themes.flatMap((t) => t.projects ?? []), ...projects.filter((p) => p.rocketry).map((p) => p.slug)]);
const list = projects.filter((p) => !elsewhere.has(p.slug));
const groups = categories.map((c) => ({ ...c, items: list.filter((p) => p.category[0] === c.id) })).filter((g) => g.items.length);
---
<Base title="Fun Projects" description="Engineering builds, Python packages, apps and desktop widgets by Dara Rahmat Samii.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Fun projects</span>
      <h1>Things I build for fun</h1>
      <p class="lead">Side projects: hardware, software and a bit of machine learning. Research lives on <a href="/research/">Research</a>, rocket work on <a href="/rocketry/">Rocketry</a>.</p>
      <div class="pills" style="margin-top:28px">
        {groups.map((g) => <a class="pill" href={`#${g.id}`}>{g.label} <span class="tag" style="margin-left:4px">{g.items.length}</span></a>)}
      </div>
    </div>
  </section>
  {groups.map((g, n) => (
    <section class:list={['section', { 'section-alt': n % 2 === 0 }]} id={g.id} style="padding:72px 0">
      <div class="container">
        <div class="section-head"><div><span class="kicker">{g.items.length} project{g.items.length > 1 ? 's' : ''}</span><h2>{g.label}</h2></div></div>
        <div class="features">{g.items.map((p, i) => <ProjectFeature p={p} flip={i % 2 === 1} />)}</div>
      </div>
    </section>
  ))}
  <ImageModal />
</Base>
