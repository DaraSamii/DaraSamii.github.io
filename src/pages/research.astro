---
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ImageModal from '../components/ImageModal.astro';
import { themes, conferences } from '../data/research.js';
import { researchInterests } from '../data/cv.js';
import { bySlug } from '../data/projects.js';
import { socials } from '../data/profile.js';
const scholar = socials.find((s) => s.label === 'Google Scholar').href;
---
<Base title="Research" description="Research of Dara Rahmat Samii: DNS/LES of hydrogen–methane flames (McGill), supersonic particle-laden jets and aeroacoustics, graph neural network CFD surrogates, and supersonic rocket aerodynamics.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Research</span>
      <h1>Compressible, reacting and particle-laden flows</h1>
      <p class="lead">I work where high-fidelity simulation meets engineering decisions: writing solvers when the standard ones fall short, verifying them carefully, and using machine learning where it actually saves compute.</p>
      <div class="actions">
        <a class="btn btn-primary" href={scholar} target="_blank" rel="noopener"><i class="fas fa-graduation-cap" aria-hidden="true"></i> Google Scholar</a>
        <a class="btn btn-secondary" href="#publications">Publications</a>
      </div>
      <div class="tags" style="margin-top:28px">{researchInterests.map((r) => <span class="tag tag-cobalt">{r}</span>)}</div>
    </div>
  </section>

  {themes.map((t, n) => (
    <section class:list={['section', { 'section-alt': n % 2 === 0 }]} id={t.id} style="padding:80px 0">
      <div class="container">
        <div class="row" style="gap:20px">
          <div class="card-icon" style={`width:56px;height:56px;font-size:22px;--ic:${t.color}`}><i class={t.icon} aria-hidden="true"></i></div>
          <div style="max-width:820px">
            <span class="kicker">{t.kicker}</span>
            <h2 style="font-size:clamp(26px,3.2vw,36px);margin-top:8px">{t.title}</h2>
            <p style="margin-top:14px;font-size:17px;color:var(--charcoal);line-height:1.65">{t.text}</p>
            <div class="tags" style="margin-top:14px">{t.tags.map((x) => <span class="tag">{x}</span>)}</div>
            {(t.links || t.more) && (
              <div class="links">
                {t.links?.map((l) => <a class="link-chip" href={l.href} target="_blank" rel="noopener"><i class={l.icon} aria-hidden="true"></i> {l.label}</a>)}
                {t.more && <a class="link-chip" href={t.more.href}>{t.more.label} →</a>}
              </div>
            )}
          </div>
        </div>
        {t.projects && <div class="features" style="margin-top:48px">{t.projects.map((s, i) => <ProjectFeature p={bySlug[s]} flip={i % 2 === 1} />)}</div>}
      </div>
    </section>
  ))}

  <section class="section" id="publications">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Publications</span><h2>Papers</h2></div></div>
      <PubList />
    </div>
  </section>

  <section class="section section-alt" id="talks">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Conferences</span><h2>Talks &amp; abstracts</h2></div></div>
      <div class="grid">
        {conferences.map((c) => (
          <article class="card pub reveal">
            <div class="pub-year" style="font-size:16px">{c.date}</div>
            <div>
              <h3>{c.title}</h3>
              <p class="venue">{c.venue}</p>
              {c.href && <div class="links"><a class="link-chip" href={c.href} target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> Abstract</a></div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ImageModal />
</Base>
