---
import Base from '../layouts/Base.astro';
import AirfoilPlayground from '../components/AirfoilPlayground.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ImageModal from '../components/ImageModal.astro';
import PubList from '../components/PubList.astro';
import { profile, socials, profilePhotos, stats, cvHref, coffee } from '../data/profile.js';
import { education, experience, awards, certifications, skills, researchInterests } from '../data/cv.js';
import { bySlug } from '../data/projects.js';
const featured = ['cr26-cfd', 'thermal-spray', 'mesh-gnn'].map((s) => bySlug[s]);
---
<Base>
  <section class="hero" id="home">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">{profile.role}</span>
          <h1>Dara Rahmat Samii.<br /><span class="accent">{profile.headline}</span></h1>
          <p class="lead">{profile.intro}</p>
          <div class="actions">
            <a href="/research/" class="btn btn-primary">Explore my research</a>
          </div>
          <div class="socials">
            {socials.map((s) => <a class="icon-btn brand" style={`--brand:${s.color}`} href={s.href} target="_blank" rel="noopener" aria-label={s.label}><i class={s.icon} aria-hidden="true"></i></a>)}
            <a class="icon-btn brand" style="--brand:#ea4335" href={`mailto:${profile.email}`} aria-label="Email"><i class="fas fa-envelope" aria-hidden="true"></i></a>
            <a class="icon-btn coffee" href={coffee.href} target="_blank" rel="noopener" aria-label={coffee.label}><i class="fas fa-mug-hot" aria-hidden="true"></i></a>
          </div>
        </div>
        <div style="position:relative">
          <div class="hero-photo">
            {profilePhotos.map((src, i) => <img src={src} alt={profile.name} class={i === 0 ? 'active' : undefined} loading={i === 0 ? 'eager' : 'lazy'} />)}
            <div class="float-badge badge-1"><i class="fas fa-rocket" aria-hidden="true" style="color:#e41e3f"></i> L3 Certified</div>
            <div class="float-badge badge-2"><img src="/assets/images/logos/mcgill-crest.png" alt="" /> PhD · McGill</div>
          </div>
        </div>
      </div>
      <div class="stats">
        {stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="airfoil">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Interactive</span>
          <h2>Make an airfoil fly</h2>
          <p>An exact potential-flow solution, not an animation. Pitch the airfoil, thicken it, add camber, and watch the pressure and lift respond. Then switch off the Kutta condition and see what goes wrong.</p>
        </div>
      </div>
      <AirfoilPlayground />
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="section-head"><div><span class="kicker">About</span><h2>Research background, engineering habits</h2></div></div>
      <div class="grid grid-2" style="align-items:start">
        <div class="prose reveal" style="font-size:17px">
          <p>I completed my M.A.Sc. in Mechanical Engineering at Concordia University in June 2026 (thesis graded <strong>Outstanding</strong>, GPA 4.23/4.3), with a background in Chemical Engineering, focused on integrating machine learning with computational fluid dynamics. In January 2027 I start a <strong>Ph.D. at McGill University</strong> in the ASEC Lab with Prof. Hendrik Nicolai, on DNS/LES of hydrogen–methane flames.</p>
          <p>My research explores how Graph Neural Networks can accelerate CFD simulations, achieving <strong>100× speedup</strong> over traditional solvers. I execute RANS, DDES, and aeroacoustic simulations on HPC clusters (400+ CPU cores, Compute Canada) for thermal spray coating analysis.</p>
          <p>I lead CFD simulations for Space Concordia’s solid rocketry team (CR25 and CR26 rockets), contribute to OpenRocket and RocketCalculator, and hold L3, L2, and L1 high-power rocketry certifications from the Canadian Association of Rocketry.</p>
          <p>I also teach: 1,200+ hours as a TA in fluid mechanics, heat transfer, thermodynamics and CFD, recognised with Concordia’s Teaching Excellence Award. <a href="/teaching/">Course notes are on the way →</a></p>
          <div class="tags" style="margin-top:20px">{researchInterests.map((r) => <span class="tag tag-cobalt">{r}</span>)}</div>
        </div>
        <div class="grid" style="gap:12px">
          {skills.map((s) => (
            <div class="card reveal row" style="padding:18px 20px">
              <div class="card-icon"><i class={s.icon} aria-hidden="true"></i></div>
              <div><h3 style="font-size:16px">{s.title}</h3><div class="tags" style="margin-top:8px">{s.items.map((t) => <span class="tag">{t}</span>)}</div></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="projects">
    <div class="container">
      <div class="section-head">
        <div><span class="kicker">Selected work</span><h2>From solver source code to flight data</h2></div>
        <a href="/research/" class="btn btn-secondary">All research</a>
      </div>
      <div class="grid grid-3">{featured.map((p) => <ProjectCard p={p} />)}</div>
    </div>
  </section>

  <section class="section" id="publications">
    <div class="container">
      <div class="section-head">
        <div><span class="kicker">Publications</span><h2>Peer-reviewed &amp; preprints</h2></div>
        <a href="/research/" class="btn btn-secondary">Research &amp; talks</a>
      </div>
      <PubList />
    </div>
  </section>

  <section class="section section-alt" id="education">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Education</span><h2>Chemical → mechanical → combustion</h2></div></div>
      <div class="timeline">
        {education.map((e) => (
          <div class="card edu reveal">
            {e.logo ? <img class="edu-logo" src={e.logo} alt={e.school} loading="lazy" /> : <div class="edu-logo fallback" aria-hidden="true">McG</div>}
            <div>
              <h3>{e.school}</h3>
              <p class="meta">{e.degree} · <i class="fas fa-map-marker-alt" aria-hidden="true"></i> {e.location}</p>
              <dl>{e.details.map(([k, v]) => <><dt>{k}</dt><dd set:html={v} /></>)}</dl>
            </div>
            <div class="right"><span>{e.date}</span>{e.badges.map((b) => <span class="tag tag-cobalt">{b}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Experience</span><h2>Where I’ve worked</h2></div></div>
      <div class="grid grid-2">
        {experience.map((x) => (
          <div class="card reveal row">
            <div class="card-icon"><i class={x.icon} aria-hidden="true"></i></div>
            <div>
              <h3>{x.title}</h3>
              <p class="meta"><strong>{x.org}</strong> · {x.date}</p>
              <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="awards">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Recognition</span><h2>Honors &amp; Awards</h2></div></div>
      <div class="grid grid-3">
        {awards.map((a) => (
          <div class="card reveal row">
            <div class="card-icon"><i class={a.icon} aria-hidden="true"></i></div>
            <div><span class="tag">{a.year}</span><h3 style="margin-top:8px;font-size:16px">{a.title}</h3><p class="meta">{a.text}</p>{a.href && <a class="link-chip" style="margin-top:10px" href={a.href}><i class="fas fa-images" aria-hidden="true"></i> Photos</a>}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="certifications">
    <div class="container">
      <div class="section-head"><div><span class="kicker">Certifications</span><h2>Rockets and courses</h2></div></div>
      <div class="grid grid-4">
        {certifications.map((c) => (
          <div class="card reveal">
            <div class="card-icon"><i class={c.icon} aria-hidden="true"></i></div>
            <h3 style="margin-top:14px;font-size:16px">{c.title}</h3>
            <p class="meta">{c.org}{c.date && ` · ${c.date}`}</p>
            {c.rocket && <p class="meta">Rocket: <strong>{c.rocket}</strong> · <a href="/rocketry/#certifications">photos</a></p>}
            {c.href && <a class="link-chip" style="margin-top:12px" href={c.href} target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> View Credential</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contact" style="padding-top:0">
    <div class="container">
      <div class="promo">
        <div>
          <h2>Let’s connect</h2>
          <p>I’m always interested in collaborating on CFD, combustion, ML, rocketry or teaching projects.</p>
        </div>
        <div class="pills" style="justify-content:flex-end">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}><i class="fas fa-envelope" aria-hidden="true"></i> Email</a>
          <a class="btn btn-secondary" style="color:var(--canvas);border-color:var(--canvas)" href={cvHref} target="_blank" rel="noopener">CV</a>
          <a class="btn btn-coffee" href={coffee.href} target="_blank" rel="noopener"><i class="fas fa-mug-hot" aria-hidden="true"></i> {coffee.label}</a>
        </div>
      </div>
    </div>
  </section>
  <ImageModal />
</Base>
