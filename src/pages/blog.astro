---
import Base from '../layouts/Base.astro';
import { blogPosts, virgool } from '../data/personal.js';
---
<Base title="Blog" description="Dara Rahmat Samii's writing (in Persian) on Virgool: moving to Canada, learning game theory, IELTS self-study, the chemical engineering olympiad and boogie-woogie piano.">
  <Fragment slot="head"><link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700&display=swap" rel="stylesheet" /></Fragment>
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Blog</span>
      <h1>Writing</h1>
      <p class="lead">My writings about experiences, learning, and life (in Persian).</p>
      <div class="actions"><a class="btn btn-secondary" href={virgool} target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> Read on Virgool</a></div>
    </div>
  </section>
  <section class="section" style="padding-top:8px">
    <div class="container grid grid-3">
      {blogPosts.map((p) => (
        <a class="card card-hover blog-card reveal" href={p.href} target="_blank" rel="noopener" style="color:inherit;text-decoration:none">
          <img src={p.image} alt={p.alt} loading="lazy" />
          <div class="body rtl" lang="fa">
            <span class="tag" style="justify-self:start">ویرگول</span>
            <h3 style="font-family:inherit">{p.title}</h3>
            <p class="meta">{p.excerpt}</p>
            <span style="color:var(--primary);font-weight:600">ادامه مطلب <i class="fas fa-arrow-left" aria-hidden="true"></i></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
